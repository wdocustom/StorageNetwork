{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "storage-network",
  // Custom entry: wraps the OpenNext worker and adds the cron handler.
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Test address (storage-network.<account>.workers.dev) and per-branch
  // preview URLs. Stated explicitly to silence wrangler's default warnings;
  // consider workers_dev: false after cutover so only the real domain serves.
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference used by OpenNext for ISR revalidation; must match "name".
      "binding": "WORKER_SELF_REFERENCE",
      "service": "storage-network"
    }
  ],
  "r2_buckets": [
    {
      // Next.js incremental cache (revalidate / unstable_cache).
      // Create once: npx wrangler r2 bucket create storage-network-opennext-cache
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "storage-network-opennext-cache"
    }
  ],
  "images": {
    // next/image optimization via Cloudflare Images
    "binding": "IMAGES"
  },
  "limits": {
    // Cron batch jobs ran with maxDuration up to 300s on Vercel. CPU time is
    // only the compute share (network waits don't count); 5 min is the max.
    "cpu_ms": 300000
  },
  // Keep plain-text variables added in the dashboard across deploys.
  // Without this, every `wrangler deploy` (each Workers Build) deletes any
  // dashboard "Text" variable not listed under "vars" below. Secrets
  // (type "Secret") always survive; prefer that type for keys.
  "keep_vars": true,
  "vars": {
    // Keep "false" while Vercel is still live — both would run every job and
    // customers would get each scheduled email twice. Flip to "true" at
    // cutover, in the same change that removes vercel.json crons.
    "CRONS_ENABLED": "false"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    // One entry per distinct schedule in src/config/cron-jobs.ts (UTC).
    "crons": [
      "0 9 * * *",
      "0 10 * * *",
      "0 0 * * *",
      "0 8 * * *",
      "0 11 * * *",
      "0 14 * * *",
      "0 15 * * *",
      "0 7 * * *",
      "0 16 * * *",
      "0 13 * * *",
      "0 12 * * *",
      "0 17 * * *",
      "0 18 * * *",
      "0 19 * * *",
      "0 9 * * 1",
      "0 6 * * *"
    ]
  }
}
