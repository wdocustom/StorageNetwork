<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications. Use "production" for App Store / TestFlight builds. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal links. Requires /.well-known/apple-app-site-association (TEAMID filled in). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:storage-network.app</string>
	</array>
</dict>
</plist>
